# ==================== DATABASE ====================
# PostgreSQL connection string for asyncpg
APP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tenders

# ==================== EIS / GOSPLAN INTEGRATION ====================
APP_GOSPLAN_BASE_URL=https://api.gosplan.info
APP_GOSPLAN_API_KEY=your_api_key_here
APP_GOSPLAN_TIMEOUT_SEC=30

# ==================== APPLICATION ====================
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== REDIS (optional for caching) ====================
APP_REDIS_URL=redis://localhost:6379/0

# ==================== SECURITY ====================
APP_SECRET_KEY=change-me-in-production-min-32-chars